{
  "format": "mygraph-vectors/1",
  "spec_version": "0.1.0-draft",
  "spec": "spec/model/normalization.md",
  "groups": [
    {
      "function": "name_key",
      "rules": ["NORM-NAME-1", "NORM-NAME-2", "NORM-NAME-3", "NORM-NAME-4"],
      "description": "String -> name key. Non-ASCII characters are written as \\u escapes; 'note' shows the readable form.",
      "cases": [
        { "input": "Ada Lovelace", "output": "ada lovelace" },
        { "input": "  Ada   Lovelace  ", "output": "ada lovelace", "note": "spaces collapsed and trimmed" },
        { "input": "ADA LOVELACE", "output": "ada lovelace" },
        { "input": "Ada\tLovelace\n", "output": "ada lovelace", "note": "tab and newline are White_Space" },
        { "input": "Ada Lovelace", "output": "ada lovelace", "note": "no-break space" },
        { "input": "Ada　Lovelace", "output": "ada lovelace", "note": "ideographic space" },
        { "input": "Ada­Lovelace", "output": "adalovelace", "note": "soft hyphen (Cf) removed" },
        { "input": "Ada​Lovelace", "output": "adalovelace", "note": "zero-width space (Cf) removed" },
        { "input": "Café Müller", "output": "cafe muller", "note": "Café Müller" },
        { "input": "Café", "output": "cafe", "note": "decomposed accent" },
        { "input": "Ångström", "output": "angstrom", "note": "Ångström" },
        { "input": "Ångström", "output": "angstrom", "note": "ANGSTROM SIGN" },
        { "input": "Straße", "output": "strasse", "note": "Straße" },
        { "input": "STRASSE", "output": "strasse" },
        { "input": "GROẞE", "output": "grosse", "note": "capital sharp s folds to ß, then to ss" },
        { "input": "Søren Kierkegaard", "output": "soren kierkegaard", "note": "Søren" },
        { "input": "Łódź", "output": "lodz", "note": "Łódź" },
        { "input": "Nguyễn", "output": "nguyen", "note": "Nguyễn: two stacked marks" },
        { "input": "Ǆemal", "output": "dzemal", "note": "Ǆ (DZ with caron digraph)" },
        { "input": "ǅemal", "output": "dzemal", "note": "ǅ (titlecase digraph)" },
        { "input": "İstanbul", "output": "istanbul", "note": "İ (capital I with dot)" },
        { "input": "ıstanbul", "output": "istanbul", "note": "ı (dotless i)" },
        { "input": "Æsop", "output": "aesop", "note": "Æsop" },
        { "input": "Œuvre", "output": "oeuvre", "note": "Œuvre" },
        { "input": "Þór", "output": "thor", "note": "Þór" },
        { "input": "O’Brien", "output": "obrien", "note": "typographic apostrophe" },
        { "input": "O'Brien", "output": "obrien" },
        { "input": "“The Analytical Engine”", "output": "the analytical engine", "note": "curly quotes" },
        { "input": "Jean-Paul Sartre", "output": "jean paul sartre" },
        { "input": "Jean‐Paul", "output": "jean paul", "note": "HYPHEN" },
        { "input": "Jean‑Paul", "output": "jean paul", "note": "NON-BREAKING HYPHEN (NFKD -> HYPHEN)" },
        { "input": "1914–1918", "output": "1914 1918", "note": "en dash" },
        { "input": "research_paper", "output": "research paper" },
        { "input": "ﬁnance", "output": "finance", "note": "fi ligature" },
        { "input": "Ｔｏｋｙｏ", "output": "tokyo", "note": "fullwidth letters" },
        { "input": "Ⅻ", "output": "xii", "note": "ROMAN NUMERAL TWELVE" },
        { "input": "E=mc²", "output": "e=mc2", "note": "superscript two" },
        { "input": "Ω", "output": "ω", "note": "OHM SIGN -> omega" },
        { "input": "K", "output": "k", "note": "KELVIN SIGN" },
        { "input": "Αθήνα", "output": "αθηνα", "note": "Αθήνα -> αθηνα (Greek accents removed)" },
        { "input": "ΟΔΥΣΣΕΥΣ", "output": "οδυσσευσ", "note": "capital sigma folds to σ" },
        { "input": "Οδυσσεύς", "output": "οδυσσευσ", "note": "final sigma ς folds to σ: same key as the capitalized form" },
        { "input": "ᾳ", "output": "αι", "note": "alpha with ypogegrammeni: the subscript iota folds to ι in step 3, so it is a letter, not a removed mark" },
        { "input": "Ёлка", "output": "елка", "note": "Ёлка -> елка (ё folds to е)" },
        { "input": "Йошкар-Ола", "output": "йошкар ола", "note": "Йошкар-Ола: й keeps its breve" },
        { "input": "Київ", "output": "київ", "note": "Київ: Ukrainian ї keeps its diaeresis" },
        { "input": "क्षत्रिय", "output": "क्षत्रिय", "note": "Devanagari marks are kept" },
        { "input": "東京", "output": "東京", "note": "東京 unchanged" },
        { "input": "C# 12", "output": "c# 12", "note": "symbols and punctuation outside the tables are kept" },
        { "input": "C++", "output": "c++" },
        { "input": "AT&T", "output": "at&t" },
        { "input": "J.R.R. Tolkien", "output": "j.r.r. tolkien" },
        { "input": "AC/DC", "output": "ac/dc" },
        { "input": "́abc", "output": "́abc", "note": "a mark with no base is kept" },
        { "input": "'", "output": "", "note": "empty key: invalid as a node name (NORM-NAME-5)" },
        { "input": "—", "output": "" },
        { "input": "", "output": "" }
      ]
    }
  ]
}
