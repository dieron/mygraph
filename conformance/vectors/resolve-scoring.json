{
  "format": "mygraph-vectors/1",
  "spec_version": "0.1.0-draft",
  "spec": "spec/algorithms/resolve-scoring.md",
  "groups": [
    {
      "function": "resolve_hint_agrees",
      "rules": ["RES-5"],
      "description": "[hint, stored value] in write form -> whether the hint agrees.",
      "cases": [
        { "input": [{ "$date": "1791" }, { "$date": "1791-12-26" }], "output": true },
        { "input": [{ "$date": "1791-11" }, { "$date": "1791-12-26" }], "output": false },
        { "input": [{ "$date": "1791-12" }, { "$date": "1791" }], "output": true },
        { "input": [{ "$date": "1790" }, { "$date": "1791" }], "output": false },
        { "note": "Strings compare by name key.", "input": ["ROYAL  Society", "royal society"], "output": true },
        { "input": ["Royal Society", "Royal Institution"], "output": false },
        { "input": [1843, 1843], "output": true },
        { "note": "Different kinds conflict.", "input": ["1843", 1843], "output": false },
        { "input": [true, false], "output": false }
      ]
    },
    {
      "function": "resolve_verdict",
      "rules": ["RES-7"],
      "description": "Scores of the scored nodes, highest first -> verdict.",
      "cases": [
        { "input": [], "output": "none" },
        { "input": [0.45], "output": "none" },
        { "input": [0.59], "output": "none" },
        { "input": [0.6], "output": "ambiguous" },
        { "input": [0.79], "output": "ambiguous" },
        { "input": [0.8], "output": "match" },
        { "input": [0.95, 0.84], "output": "match" },
        { "note": "Exactly 0.1 apart is still within 0.1.", "input": [0.95, 0.85], "output": "ambiguous" },
        { "input": [1.0, 1.0], "output": "ambiguous" },
        { "note": "Below 0.6 is not plausible, so it does not compete.", "input": [0.85, 0.59], "output": "match" }
      ]
    }
  ]
}
