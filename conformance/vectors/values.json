{
  "format": "mygraph-vectors/1",
  "spec_version": "0.1.0-draft",
  "spec": "spec/model/values.md",
  "groups": [
    {
      "function": "parse_value",
      "rules": ["VAL-KIND-1", "VAL-KIND-2", "VAL-STR-1", "VAL-STR-2", "VAL-STR-3", "VAL-NUM-1", "VAL-NUM-2", "VAL-NUM-3"],
      "description": "Raw JSON text of a property value -> kind and canonical value, 'remove', or a reason code. Inputs are JSON text (input_json) so that the lexical form of numbers is preserved. Float outputs are compared numerically.",
      "cases": [
        { "input_json": "\"British\"", "output": { "kind": "string", "value": "British" } },
        { "input_json": "\"\"", "output": { "kind": "string", "value": "" }, "note": "empty string is a value" },
        { "input_json": "\"e\\u0301\"", "output": { "kind": "string", "value": "\u00e9" }, "note": "converted to NFC" },
        { "input_json": "\"line1\\nline2\\r\\n\\tend\"", "output": { "kind": "string", "value": "line1\nline2\r\n\tend" }, "note": "tab, LF and CR are allowed" },
        { "input_json": "\"a\\u0000b\"", "error": "value.string.control_char" },
        { "input_json": "\"a\\u0007b\"", "error": "value.string.control_char" },
        { "input_json": "\"\\ud800\"", "error": "text.invalid_unicode", "note": "unpaired surrogate" },
        { "input_repeat": { "unit": "a", "count": 8192 }, "output": { "kind": "string", "value_repeat": { "unit": "a", "count": 8192 } }, "note": "input_repeat builds a JSON string value" },
        { "input_repeat": { "unit": "a", "count": 8193 }, "error": "value.string.too_long" },
        { "input_repeat": { "unit": "\u00e9", "count": 4097 }, "error": "value.string.too_long", "note": "8194 bytes" },

        { "input_json": "1815", "output": { "kind": "int", "value": 1815 } },
        { "input_json": "-42", "output": { "kind": "int", "value": -42 } },
        { "input_json": "0", "output": { "kind": "int", "value": 0 } },
        { "input_json": "9223372036854775807", "output": { "kind": "int", "value": 9223372036854775807 } },
        { "input_json": "-9223372036854775808", "output": { "kind": "int", "value": -9223372036854775808 } },
        { "input_json": "9223372036854775808", "error": "value.int.out_of_range" },
        { "input_json": "1815.0", "output": { "kind": "float", "value": 1815.0 }, "note": "a fraction makes it a float" },
        { "input_json": "1e3", "output": { "kind": "float", "value": 1000.0 }, "note": "an exponent makes it a float" },
        { "input_json": "1E2", "output": { "kind": "float", "value": 100.0 } },
        { "input_json": "0.1", "output": { "kind": "float", "value": 0.1 } },
        { "input_json": "6.02e23", "output": { "kind": "float", "value": 6.02e23 } },
        { "input_json": "-0.0", "output": { "kind": "float", "value": 0.0 }, "note": "negative zero becomes 0.0 (check the sign bit)" },
        { "input_json": "1e400", "error": "value.float.out_of_range" },
        { "input_json": "1e-400", "output": { "kind": "float", "value": 0.0 }, "note": "underflow becomes zero" },

        { "input_json": "true", "output": { "kind": "bool", "value": true } },
        { "input_json": "false", "output": { "kind": "bool", "value": false } },
        { "input_json": "null", "output": { "remove": true } }
      ]
    },
    {
      "function": "parse_value",
      "rules": ["VAL-DATE-1", "VAL-DATE-2", "VAL-DATE-3", "VAL-DATE-4", "VAL-DATE-5", "VAL-DATE-6"],
      "description": "Dates.",
      "cases": [
        { "input_json": "{\"$date\": \"1815-12-10\"}", "output": { "kind": "date", "value": { "$date": "1815-12-10" }, "precision": "day" } },
        { "input_json": "{\"$date\": \"1815-12\"}", "output": { "kind": "date", "value": { "$date": "1815-12" }, "precision": "month" } },
        { "input_json": "{\"$date\": \"1815\"}", "output": { "kind": "date", "value": { "$date": "1815" }, "precision": "year" } },
        { "input_json": "{\"$date\": \"-0427\"}", "output": { "kind": "date", "value": { "$date": "-0427" }, "precision": "year" }, "note": "428 BC" },
        { "input_json": "{\"$date\": \"0000\"}", "output": { "kind": "date", "value": { "$date": "0000" }, "precision": "year" }, "note": "1 BC" },
        { "input_json": "{\"$date\": \"2024-02-29\"}", "output": { "kind": "date", "value": { "$date": "2024-02-29" }, "precision": "day" } },
        { "input_json": "{\"$date\": \"2000-02-29\"}", "output": { "kind": "date", "value": { "$date": "2000-02-29" }, "precision": "day" } },
        { "input_json": "{\"$date\": \"0000-02-29\"}", "output": { "kind": "date", "value": { "$date": "0000-02-29" }, "precision": "day" }, "note": "year 0 is a leap year" },
        { "input_json": "{\"$date\": \"-0004-02-29\"}", "output": { "kind": "date", "value": { "$date": "-0004-02-29" }, "precision": "day" } },
        { "input_json": "{\"$date\": \"-0400-02-29\"}", "output": { "kind": "date", "value": { "$date": "-0400-02-29" }, "precision": "day" } },
        { "input_json": "{\"$date\": \"2023-02-29\"}", "error": "value.date.invalid_day" },
        { "input_json": "{\"$date\": \"1900-02-29\"}", "error": "value.date.invalid_day" },
        { "input_json": "{\"$date\": \"-0100-02-29\"}", "error": "value.date.invalid_day" },
        { "input_json": "{\"$date\": \"1815-04-31\"}", "error": "value.date.invalid_day" },
        { "input_json": "{\"$date\": \"1815-12-32\"}", "error": "value.date.invalid_day" },
        { "input_json": "{\"$date\": \"1815-12-00\"}", "error": "value.date.invalid_day" },
        { "input_json": "{\"$date\": \"1815-13\"}", "error": "value.date.invalid_month" },
        { "input_json": "{\"$date\": \"1815-00\"}", "error": "value.date.invalid_month" },
        { "input_json": "{\"$date\": \"-0000\"}", "error": "value.date.malformed" },
        { "input_json": "{\"$date\": \"815\"}", "error": "value.date.malformed" },
        { "input_json": "{\"$date\": \"18151\"}", "error": "value.date.malformed" },
        { "input_json": "{\"$date\": \"1815-1-1\"}", "error": "value.date.malformed" },
        { "input_json": "{\"$date\": \" 1815\"}", "error": "value.date.malformed" },
        { "input_json": "{\"$date\": \"+1815\"}", "error": "value.date.malformed" },
        { "input_json": "{\"$date\": \"1815-12-10T00:00:00Z\"}", "error": "value.date.malformed" }
      ]
    },
    {
      "function": "parse_value",
      "rules": ["VAL-DT-1", "VAL-DT-2", "VAL-DT-3"],
      "description": "Date-times.",
      "cases": [
        { "input_json": "{\"$datetime\": \"2026-10-24T08:15:00Z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T08:15:00Z" } } },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00+02:00\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T08:15:00Z" } } },
        { "input_json": "{\"$datetime\": \"2026-10-24t10:15:00z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T10:15:00Z" } }, "note": "lowercase t and z" },
        { "input_json": "{\"$datetime\": \"2026-01-01T00:30:00+01:00\"}", "output": { "kind": "datetime", "value": { "$datetime": "2025-12-31T23:30:00Z" } }, "note": "the date changes when converting to UTC" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00-05:30\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T15:45:00Z" } } },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00-00:00\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T10:15:00Z" } } },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00.123456789Z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T10:15:00.123Z" } }, "note": "truncated to milliseconds" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00.9999Z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T10:15:00.999Z" } }, "note": "truncated, not rounded" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00.5Z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T10:15:00.500Z" } } },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00.000Z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T10:15:00Z" } }, "note": "zero milliseconds are omitted" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00.0009Z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2026-10-24T10:15:00Z" } } },
        { "input_json": "{\"$datetime\": \"2024-02-29T12:00:00Z\"}", "output": { "kind": "datetime", "value": { "$datetime": "2024-02-29T12:00:00Z" } } },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00\"}", "error": "value.datetime.missing_offset" },
        { "input_json": "{\"$datetime\": \"2026-10-24 10:15:00Z\"}", "error": "value.datetime.malformed" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15Z\"}", "error": "value.datetime.malformed" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00.Z\"}", "error": "value.datetime.malformed" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00.1234567890Z\"}", "error": "value.datetime.malformed", "note": "10 fraction digits" },
        { "input_json": "{\"$datetime\": \"-0001-01-01T00:00:00Z\"}", "error": "value.datetime.malformed" },
        { "input_json": "{\"$datetime\": \"0000-01-01T00:00:00Z\"}", "error": "value.datetime.invalid_date" },
        { "input_json": "{\"$datetime\": \"2026-02-29T00:00:00Z\"}", "error": "value.datetime.invalid_date" },
        { "input_json": "{\"$datetime\": \"2026-13-01T00:00:00Z\"}", "error": "value.datetime.invalid_date" },
        { "input_json": "{\"$datetime\": \"2026-10-24T24:00:00Z\"}", "error": "value.datetime.invalid_time" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:60:00Z\"}", "error": "value.datetime.invalid_time" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:60Z\"}", "error": "value.datetime.invalid_time", "note": "no leap seconds" },
        { "input_json": "{\"$datetime\": \"2026-10-24T10:15:00+24:00\"}", "error": "value.datetime.invalid_time" },
        { "input_json": "{\"$datetime\": \"0001-01-01T00:30:00+01:00\"}", "error": "value.datetime.out_of_range" },
        { "input_json": "{\"$datetime\": \"9999-12-31T23:30:00-01:00\"}", "error": "value.datetime.out_of_range" }
      ]
    },
    {
      "function": "parse_value",
      "rules": ["VAL-WRAP-1"],
      "description": "Wrapper objects.",
      "cases": [
        { "input_json": "{\"$date\": 1815}", "error": "value.wrapper.not_string" },
        { "input_json": "{\"$date\": \"1815\", \"note\": \"x\"}", "error": "value.wrapper.extra_member" },
        { "input_json": "{\"$date\": \"1815\", \"$datetime\": \"2026-10-24T08:15:00Z\"}", "error": "value.wrapper.extra_member" },
        { "input_json": "{\"$qty\": 5}", "error": "value.wrapper.unknown", "note": "reserved for a later version" },
        { "input_json": "{}", "error": "value.object_not_allowed" },
        { "input_json": "{\"city\": \"London\"}", "error": "value.object_not_allowed" },
        { "input_json": "{\"$a\": \"x\", \"$b\": \"y\"}", "error": "value.object_not_allowed" }
      ]
    },
    {
      "function": "parse_value",
      "rules": ["VAL-LIST-1", "VAL-LIST-2", "VAL-LIST-3", "VAL-LIST-4", "VAL-LIST-5"],
      "description": "Lists.",
      "cases": [
        { "input_json": "[\"en\", \"fr\", \"en\"]", "output": { "kind": "list<string>", "value": ["en", "fr", "en"] }, "note": "order and duplicates kept" },
        { "input_json": "[1, 2, 3]", "output": { "kind": "list<int>", "value": [1, 2, 3] } },
        { "input_json": "[1, 2.5]", "output": { "kind": "list<float>", "value": [1.0, 2.5] }, "note": "int and float mix into a float list" },
        { "input_json": "[true, false]", "output": { "kind": "list<bool>", "value": [true, false] } },
        { "input_json": "[{\"$date\": \"1815\"}, {\"$date\": \"1815-12-10\"}]", "output": { "kind": "list<date>", "value": [{ "$date": "1815" }, { "$date": "1815-12-10" }] }, "note": "dates of different precision are one kind" },
        { "input_json": "[]", "output": { "remove": true } },
        { "input_json": "[\"a\", 1]", "error": "value.list.mixed_kinds" },
        { "input_json": "[{\"$date\": \"1815\"}, {\"$datetime\": \"2026-10-24T08:15:00Z\"}]", "error": "value.list.mixed_kinds" },
        { "input_json": "[[\"a\"]]", "error": "value.list.nested" },
        { "input_json": "[\"a\", null]", "error": "value.list.null_element" },
        { "input_json": "[{\"$date\": \"1815-13\"}]", "error": "value.date.invalid_month", "note": "element errors are reported as such" },
        { "input_json": "[{\"a\": 1}]", "error": "value.object_not_allowed" },
        { "input_list_repeat": { "element_json": "1", "count": 1000 }, "output": { "kind": "list<int>", "value_list_repeat": { "element": 1, "count": 1000 } } },
        { "input_list_repeat": { "element_json": "1", "count": 1001 }, "error": "value.list.too_long" }
      ]
    },
    {
      "function": "compare_values",
      "rules": ["VAL-ORDER-1"],
      "description": "Total order: input is [a, b] as JSON text; output -1 if a sorts before b, 0 if they tie, 1 if after.",
      "cases": [
        { "input_json": "[false, true]", "output": -1 },
        { "input_json": "[true, 0]", "output": -1, "note": "bool before numbers" },
        { "input_json": "[1, 1.0]", "output": -1, "note": "equal numeric value: int before float" },
        { "input_json": "[1.5, 2]", "output": -1 },
        { "input_json": "[2, 2]", "output": 0 },
        { "input_json": "[-3, -2.5]", "output": -1 },
        { "input_json": "[9999999, {\"$date\": \"0001\"}]", "output": -1, "note": "numbers before temporal values" },
        { "input_json": "[{\"$date\": \"1815\"}, {\"$date\": \"1815-01\"}]", "output": -1, "note": "same start: coarser precision first" },
        { "input_json": "[{\"$date\": \"1815-01\"}, {\"$date\": \"1815-01-01\"}]", "output": -1 },
        { "input_json": "[{\"$date\": \"1815-01-01\"}, {\"$datetime\": \"1815-01-01T00:00:00Z\"}]", "output": -1 },
        { "input_json": "[{\"$date\": \"1815-12\"}, {\"$date\": \"1815-01-01\"}]", "output": 1, "note": "by interval start" },
        { "input_json": "[{\"$datetime\": \"1815-01-01T00:00:00.001Z\"}, {\"$date\": \"1815-01-02\"}]", "output": -1 },
        { "input_json": "[{\"$date\": \"-0427\"}, {\"$date\": \"0001\"}]", "output": -1 },
        { "input_json": "[{\"$date\": \"1815\"}, {\"$date\": \"1815\"}]", "output": 0 },
        { "input_json": "[{\"$datetime\": \"2026-01-01T00:00:00Z\"}, \"2025\"]", "output": -1, "note": "temporal before strings" },
        { "input_json": "[\"B\", \"a\"]", "output": -1, "note": "code point order, not alphabetical" },
        { "input_json": "[\"a\", \"ab\"]", "output": -1 },
        { "input_json": "[\"z\", [\"a\"]]", "output": -1, "note": "strings before lists" },
        { "input_json": "[[\"a\"], [\"a\", \"b\"]]", "output": -1, "note": "prefix first" },
        { "input_json": "[[\"b\"], [\"a\", \"c\"]]", "output": 1 }
      ]
    },
    {
      "function": "values_equal",
      "rules": ["VAL-EQ-1"],
      "description": "Equality: input is [a, b] as JSON text.",
      "cases": [
        { "input_json": "[1, 1.0]", "output": true },
        { "input_json": "[\"a\", \"A\"]", "output": false },
        { "input_json": "[true, 1]", "output": false },
        { "input_json": "[{\"$date\": \"1815\"}, {\"$date\": \"1815-01-01\"}]", "output": false, "note": "different precision" },
        { "input_json": "[{\"$datetime\": \"2026-10-24T10:15:00+02:00\"}, {\"$datetime\": \"2026-10-24T08:15:00Z\"}]", "output": true, "note": "same instant" },
        { "input_json": "[[1, 2], [1.0, 2.0]]", "output": true },
        { "input_json": "[[1, 2], [2, 1]]", "output": false }
      ]
    }
  ]
}
