# Copy to .env (never commit .env) and fill in. Make keys long and random, e.g.
#   openssl rand -hex 24
# or in PowerShell:
#   -join ((1..24) | % { '{0:x2}' -f (Get-Random -Max 256) })

# Required: full access, including /admin and the stats page.
MYGRAPH_ADMIN_KEY=

# Optional: for agents (read and write) and for read-only use.
MYGRAPH_AGENT_KEY=
MYGRAPH_READ_KEY=

# Optional: host address and port to publish on (127.0.0.1 keeps it on this machine).
MYGRAPH_BIND=0.0.0.0
MYGRAPH_PORT=7420

# Optional: graph used by clients that name none; log level.
MYGRAPH_DEFAULT_GRAPH=default
MYGRAPH_LOG=info

# Optional: search by meaning too (false: words only), and the least similarity (0-1) of a hit
# found by meaning; lower finds more, with longer results.
MYGRAPH_SEMANTIC=true
MYGRAPH_SEMANTIC_THRESHOLD=0.80

# Optional: HTTPS. MYGRAPH_CERTS is a host folder holding the certificate chain and key (readable
# by uid 65532), mounted at /certs; keep it outside this folder, which deploy/docker/deploy.sh
# replaces. Name the files as the container sees them:
# MYGRAPH_CERTS=/etc/mygraph/certs
# MYGRAPH_TLS_CERT=/certs/fullchain.pem
# MYGRAPH_TLS_KEY=/certs/privkey.pem

# Optional: run a published image instead of building, e.g. ghcr.io/<owner>/mygraph:latest
# MYGRAPH_IMAGE=
